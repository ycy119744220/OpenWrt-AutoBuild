#!/bin/sh /etc/rc.common
# DDNS-GO procd 开机自启
# Web 管理页监听所有接口的 9876 端口；OpenWrt 默认防火墙下仅 LAN 可访问，
# 若要暴露到 WAN 请自行在「网络 → 防火墙」加规则并承担风险。

START=99
STOP=10

USE_PROCD=1

start_service() {
	mkdir -p /etc/ddns-go
	procd_open_instance
	procd_set_param command /usr/bin/ddns-go
	procd_set_param args -l :9876 -c /etc/ddns-go/.ddns_go_config.yaml -f 300
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
