#
# OpenWrt 官方源 x86_64 软路由精简配置（仅保留 Intel i225 / i226 网卡）
#
# 用途：由 scripts/prepare_config.sh 清洗后复制为 openwrt/.config。
# 说明：
#   - 本文件保留手写注释（含行尾注释），kconfig 不认行尾注释，
#     因此由 prepare_config.sh 负责剥离行尾注释并去重。
#   - x86 的网卡/显卡驱动由 target/linux/x86/image/64.mk 的 DEVICE_PACKAGES
#     注入，仅靠本文件清不干净，真正的剔除在 scripts/trim_x86.py 完成。
#   - Argon 默认主题由 files/common 的 uci-defaults 脚本设置。
#   - "挂载点"（LuCI 菜单）通过不安装 luci-app-fstab / block-mount 移除。

# ===== 目标平台：x86_64 软路由 =====
# 注意：只选 subtarget，不要锁具体 DEVICE（如 x86_64_DEVICE_generic）。
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y

CONFIG_CCACHE=y

# ===== Target Images =====
# Rootfs 归档
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_TARGET_ROOTFS_CPIOGZ=n
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=n
# GRUB 镜像
CONFIG_GRUB_IMAGES=n
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_GRUB_CONSOLE=n
CONFIG_GRUB_BAUDRATE=115200
CONFIG_GRUB_FLOWCONTROL=n
CONFIG_GRUB_BOOTOPTS=""
CONFIG_GRUB_TIMEOUT="0"
CONFIG_GRUB_TITLE="OpenWrt"
CONFIG_GRUB_ISO_IMAGES=n
CONFIG_GRUB_QCOW2_IMAGES=n
CONFIG_GRUB_VDI_IMAGES=n
CONFIG_GRUB_VMDK_IMAGES=n
CONFIG_GRUB_VHDX_IMAGES=n
CONFIG_GRUB_SERIAL="ttyS0"
# 压缩与分区
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=512
CONFIG_TARGET_ROOTFS_PARTNAME=""
CONFIG_TARGET_ROOTFS_PERSIST_VAR=n

# ===== Intel i225 / i226 2.5G 网卡驱动（igc） =====
CONFIG_PACKAGE_kmod-igc=y

# ===== LuCI Web 管理界面 =====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y

# ===== 简体中文（官方开关：LuCI → Modules → Translations → Chinese (zh-cn)） =====
# 25.12 内部语言代号为 zh_Hans，语言包是隐藏包，必须用此开关选择，
# 单独写 CONFIG_PACKAGE_luci-i18n-*-zh-cn=y 会被 defconfig 丢弃。
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# ===== 网络增强 =====
CONFIG_PACKAGE_luci-app-upnp=y

# ===== 主题（jerrykuku 最新版 Argon） =====
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ===== 命令行工具 =====
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_vim=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y

# ===== 代理（OpenClash，源码由 scripts/feeds.sh 拉取） =====
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_openclash-core-meta=y
CONFIG_PACKAGE_openclash-geo-db=y

# ===== OpenClash 运行所需内核模块与工具（显式钉住，保证进固件） =====
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_ip-full=y

# ===== WAN 口 PPPoE 拨号（账号密码首次登录后在 LuCI 中填写） =====
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# ===== 关闭其他网卡 / 显卡 / 多余驱动（尽量精简） =====
CONFIG_PACKAGE_kmod-e100=n
CONFIG_PACKAGE_kmod-e1000=n
CONFIG_PACKAGE_kmod-e1000e=n
CONFIG_PACKAGE_kmod-igb=n
CONFIG_PACKAGE_kmod-igbvf=n
CONFIG_PACKAGE_kmod-ixgbe=n
CONFIG_PACKAGE_kmod-ixgbevf=n
CONFIG_PACKAGE_kmod-r8169=n
CONFIG_PACKAGE_kmod-tg3=n
CONFIG_PACKAGE_kmod-bnx2=n
CONFIG_PACKAGE_kmod-bnx2x=n
CONFIG_PACKAGE_kmod-forcedeth=n
CONFIG_PACKAGE_kmod-via-rhine=n
CONFIG_PACKAGE_kmod-via-velocity=n
CONFIG_PACKAGE_kmod-8139cp=n
CONFIG_PACKAGE_kmod-8139too=n
CONFIG_PACKAGE_kmod-pcnet32=n
CONFIG_PACKAGE_kmod-amazon-ena=n
CONFIG_PACKAGE_kmod-mlx4-core=n
CONFIG_PACKAGE_kmod-mlx5-core=n
CONFIG_PACKAGE_kmod-i40e=n
CONFIG_PACKAGE_kmod-iavf=n
CONFIG_PACKAGE_kmod-amd-xgbe=n
CONFIG_PACKAGE_kmod-alx=n
CONFIG_PACKAGE_kmod-atl1=n
CONFIG_PACKAGE_kmod-atl1c=n
CONFIG_PACKAGE_kmod-atl1e=n
CONFIG_PACKAGE_kmod-b44=n
CONFIG_PACKAGE_kmod-cnic=n
CONFIG_PACKAGE_kmod-sfc=n
CONFIG_PACKAGE_kmod-vxlan=n
# USB 网卡
CONFIG_PACKAGE_kmod-usb-net=n
CONFIG_PACKAGE_kmod-usb-net-asix=n
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=n
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=n
CONFIG_PACKAGE_kmod-usb-net-rtl8152=n
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=n
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=n
# 显卡 / 帧缓冲 / AGP / 视频
CONFIG_PACKAGE_kmod-drm-amdgpu=n
CONFIG_PACKAGE_kmod-drm-i915=n
CONFIG_PACKAGE_kmod-drm-nouveau=n
CONFIG_PACKAGE_kmod-drm-radeon=n
CONFIG_PACKAGE_kmod-drm=n
CONFIG_PACKAGE_kmod-fb=n
CONFIG_PACKAGE_kmod-fbcon=n
CONFIG_PACKAGE_kmod-agp=n
CONFIG_PACKAGE_kmod-video-core=n
CONFIG_PACKAGE_kmod-video-uvc=n

# Realtek 2.5G/5G/10G 厂商外置驱动（i225 机器用不到，尽量精简）
CONFIG_PACKAGE_kmod-r8101=n
CONFIG_PACKAGE_kmod-r8125=n
CONFIG_PACKAGE_kmod-r8126=n
CONFIG_PACKAGE_kmod-r8152=n
CONFIG_PACKAGE_kmod-r8168=n

# ===== 移除"挂载点"（LuCI 菜单中的挂载点页面） =====
CONFIG_PACKAGE_luci-app-fstab=n
CONFIG_PACKAGE_block-mount=n
