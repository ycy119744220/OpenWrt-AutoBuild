# ===== 由 CI 追加（不属于原始 x86_64.config） =====

# OpenClash 硬依赖：必须用 dnsmasq-full 替换默认 dnsmasq
CONFIG_PACKAGE_dnsmasq-full=y

# OpenClash 运行时依赖（它的 Makefile 未完整声明，缺了插件跑不起来）
CONFIG_PACKAGE_ruby-psych=y
CONFIG_PACKAGE_ruby-pstore=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_ca-bundle=y

# LuCI 兼容层（argon-config 与 OpenClash 的老接口）
CONFIG_PACKAGE_luci-compat=y

# ===== 关闭 Ruby YJIT（关键：直接决定单次构建 2 小时还是 5 小时）=====
# x86_64 上 RUBY_ENABLE_YJIT 默认 =y，而 feeds/packages/lang/ruby/Makefile 里写着
#   PKG_BUILD_DEPENDS:=ruby/host RUBY_ENABLE_YJIT:rust/host
# 也就是说 YJIT 一开，就要先编 rust/host，而 rustc 又会从源码把整套 LLVM 编一遍
# （日志里表现为 llvm-project 的 3898 个 cmake 目标），在 4 核 runner 上多耗 2 小时以上，
# 极易撞上 350 分钟超时。
# OpenClash 依赖的是 +ruby +ruby-yaml，只用 YAML 解析和 PStore，完全不需要 YJIT。
# CONFIG_RUBY_ENABLE_YJIT is not set
