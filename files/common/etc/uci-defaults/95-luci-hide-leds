#!/bin/sh
# 两个镜像共用：从 LuCI 菜单里彻底移除「系统 → LED 配置」
#
# 该菜单项由 luci-mod-system 的 menu.d JSON 定义（admin/system/leds），
# 和系统、管理权、计划任务、备份刷机同属一个包，拆包拆不掉，只能按菜单路径删。
# 只删 luci 的菜单注册，不涉及 /etc/config/system 里已有的 led 段，
# 底层 LED 驱动与 init.d/led 照常工作（网卡指示灯、电源灯不受影响）。

for key in 'admin/system/leds'; do
	if uci -q get "luci.$key" >/dev/null 2>&1; then
		uci -q delete "luci.$key"
	fi
done

uci -q commit luci
exit 0
